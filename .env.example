# Nova Admin ─ Environment Configuration
# Copy to .env and fill in values

# ─── Project ───
NODE_ENV=development
APP_NAME=Nova Admin
APP_PORT=8000

# ─── Database ───
DATABASE_URL=postgresql://nova:***@localhost:5432/nova_admin
DB_HOST=localhost
DB_PORT=5432
DB_USER=nova
DB_PASS=nova_secret_2026
DB_NAME=nova_admin

# ─── Redis ───
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ─── Security ───
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=60

# ─── SMTP ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nova-admin.com

# ─── Storage ───
STORAGE_DRIVER=local
S3_KEY=
S3_SECRET=
S3_REGION=
S3_BUCKET=

# ─── Monitoring ───
LOG_LEVEL=debug
LOG_FORMAT=json
SENTRY_DSN=

# ─── 2FA ───
TOTP_ISSUER=Nova Admin
