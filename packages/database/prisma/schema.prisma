// Nova Admin ─ Production Database Schema
// Every table: UUID PK, created_at, updated_at, deleted_at, indexes, audit fields

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// 1. USERS & AUTH
// ═══════════════════════════════════════════════════════════════

/// Core user account — supports Super Admin, Master, Agent, Client hierarchy
model User {
  id              String    @id @default(uuid()) @db.Uuid
  username        String    @unique @db.VarChar(50)
  email           String?   @unique @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  displayName     String?   @map("display_name") @db.VarChar(100)
  avatar          String?   @db.VarChar(500)
  isActive        Boolean   @default(true) @map("is_active")
  isVerified      Boolean   @default(false) @map("is_verified")
  isLocked        Boolean   @default(false) @map("is_locked")
  lockedUntil     DateTime? @map("locked_until")
  loginAttempts   Int       @default(0) @map("login_attempts")
  twoFactorSecret String?   @map("two_factor_secret") @db.VarChar(100)
  twoFactorEnabled Boolean  @default(false) @map("two_factor_enabled")
  lastLoginAt     DateTime? @map("last_login_at")
  lastLoginIp     String?   @map("last_login_ip") @db.VarChar(45)

  // Role
  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  // Hierarchy (Super Admin → Master → Agent → Client)
  masterId String? @map("master_id") @db.Uuid
  agentId  String? @map("agent_id") @db.Uuid
  master   User?   @relation("UserHierarchy", fields: [masterId], references: [id])
  agent    User?   @relation("AgentClients", fields: [agentId], references: [id])
  children User[]  @relation("UserHierarchy")
  clients  User[]  @relation("AgentClients")

  // Wallet
  balance       Float  @default(0)
  exposureLimit Float  @default(0) @map("exposure_limit")
  creditLimit   Float  @default(0) @map("credit_limit")

  // Audit
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid

  // Relations
  profile          UserProfile?
  wallet           Wallet?
  sessions         Session[]
  loginLogs        LoginLog[]
  passwordHistory  PasswordHistory[]
  walletTxns       WalletTransaction[]
  bets             Bet[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  userDevices      UserDevice[]

  @@index([roleId])
  @@index([masterId])
  @@index([agentId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("users")
}

/// Extended user profile information
model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  firstName String?  @map("first_name") @db.VarChar(100)
  lastName  String?  @map("last_name") @db.VarChar(100)
  dob       DateTime?
  gender    String?  @db.VarChar(10)
  address   String?  @db.Text
  city      String?  @db.VarChar(100)
  state     String?  @db.VarChar(100)
  country   String?  @db.VarChar(100)
  zipCode   String?  @map("zip_code") @db.VarChar(20)
  language  String?  @default("en") @db.VarChar(10)
  timezone  String?  @default("Asia/Kolkata") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

/// Role definitions (Super Admin, Master, Agent, Client)
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(50)
  slug        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(255)
  isSystem    Boolean  @default(true) @map("is_system")
  priority    Int      @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users       User[]
  permissions RolePermission[]

  @@index([slug])
  @@map("roles")
}

/// Individual permissions
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(255)
  module      String   @db.VarChar(50)
  action      String   @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  roles RolePermission[]

  @@index([module])
  @@index([name])
  @@map("permissions")
}

/// Many-to-many: Role ↔ Permission
model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

/// User sessions for JWT management
model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  refreshToken String?  @map("refresh_token")
  deviceId     String?  @map("device_id") @db.VarChar(255)
  deviceName   String?  @map("device_name") @db.VarChar(255)
  ip           String?  @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  expiresAt    DateTime @map("expires_at")
  lastActivity DateTime? @map("last_activity")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([token])
  @@index([refreshToken])
  @@index([expiresAt])
  @@index([isActive])
  @@map("sessions")
}

/// Track user devices for security
model UserDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  deviceId   String   @map("device_id") @db.VarChar(255)
  deviceName String?  @map("device_name") @db.VarChar(255)
  platform   String?  @db.VarChar(50)
  browser    String?  @db.VarChar(50)
  ip         String?  @db.VarChar(45)
  isTrusted  Boolean  @default(false) @map("is_trusted")
  lastUsed   DateTime? @map("last_used")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, deviceId])
  @@map("user_devices")
}

/// Login attempt history
model LoginLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  ip         String?  @db.VarChar(45)
  deviceId   String?  @map("device_id")
  deviceName String?  @map("device_name")
  userAgent  String?  @map("user_agent") @db.Text
  status     String   @db.VarChar(20)
  failReason String?  @map("fail_reason") @db.VarChar(100)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([status])
  @@map("login_logs")
}

/// Password change history for security
model PasswordHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  password  String   @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("password_history")
}

// ═══════════════════════════════════════════════════════════════
// 2. WALLETS & FINANCE
// ═══════════════════════════════════════════════════════════════

/// Wallet record (one per user)
model Wallet {
  id            String  @id @default(uuid()) @db.Uuid
  userId        String  @unique @map("user_id") @db.Uuid
  balance       Float   @default(0)
  exposureLimit Float   @default(0) @map("exposure_limit")
  creditLimit   Float   @default(0) @map("credit_limit")
  currency      String  @default("INR") @db.VarChar(10)
  isActive      Boolean @default(true) @map("is_active")
  version       Int     @default(1) /// Optimistic locking for concurrent updates

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         User                 @relation(fields: [userId], references: [id])
  transactions WalletTransaction[]

  @@index([userId])
  @@index([isActive])
  @@map("wallets")
}

/// Double-entry wallet transactions
model WalletTransaction {
  id            String   @id @default(uuid()) @db.Uuid
  walletId      String   @map("wallet_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  type          String   @db.VarChar(50)
  amount        Float
  balanceBefore Float    @map("balance_before")
  balanceAfter  Float    @map("balance_after")
  currency      String   @default("INR") @db.VarChar(10)
  description   String?  @db.Text
  referenceId   String?  @map("reference_id")
  referenceType String?  @map("reference_type") @db.VarChar(50)
  status        String   @default("completed") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  wallet Wallet @relation(fields: [walletId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([walletId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([referenceId])
  @@index([status])
  @@map("wallet_transactions")
}

/// Withdrawal requests
model Withdrawal {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  walletId        String   @map("wallet_id") @db.Uuid
  amount          Float
  method          String   @db.VarChar(50)
  accountName     String?  @map("account_name") @db.VarChar(255)
  accountNumber   String?  @map("account_number") @db.VarChar(50)
  bankName        String?  @map("bank_name") @db.VarChar(255)
  ifscCode        String?  @map("ifsc_code") @db.VarChar(20)
  upiId           String?  @map("upi_id") @db.VarChar(100)
  usdtAddress     String?  @map("usdt_address") @db.VarChar(255)
  status          String   @default("pending") @db.VarChar(20)
  approvedBy      String?  @map("approved_by") @db.Uuid
  approvedAt      DateTime? @map("approved_at")
  rejectionReason String?  @map("rejection_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@index([walletId])
  @@index([status])
  @@map("withdrawals")
}

/// Commission tracking for hierarchy
model Commission {
  id         String   @id @default(uuid()) @db.Uuid
  fromUserId String   @map("from_user_id") @db.Uuid
  toUserId   String   @map("to_user_id") @db.Uuid
  amount     Float
  rate       Float    @default(0)
  type       String   @db.VarChar(50)
  status     String   @default("pending") @db.VarChar(20)
  referenceId String? @map("reference_id")

  createdAt DateTime  @default(now()) @map("created_at")
  settledAt DateTime? @map("settled_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@map("commissions")
}

// ═══════════════════════════════════════════════════════════════
// 3. SPORTS & BETTING
// ═══════════════════════════════════════════════════════════════

/// Sports categories
model Sport {
  id           Int     @id @default(autoincrement())
  name         String  @db.VarChar(100)
  slug         String  @unique @db.VarChar(100)
  icon         String? @db.VarChar(10)
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  events  Event[]
  markets MarketTemplate[]

  @@map("sports")
}

/// Sports events/matches
model Event {
  id        Int      @id @default(autoincrement())
  sportId   Int      @map("sport_id")
  title     String   @db.VarChar(255)
  homeTeam  String?  @map("home_team") @db.VarChar(255)
  awayTeam  String?  @map("away_team") @db.VarChar(255)
  startTime DateTime @map("start_time")
  endTime   DateTime? @map("end_time")
  status    String   @default("upcoming") @db.VarChar(20)
  priority  Int      @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  settledAt DateTime? @map("settled_at")

  sport   Sport   @relation(fields: [sportId], references: [id])
  markets Market[]
  bets    Bet[]

  @@index([sportId])
  @@index([status])
  @@index([startTime])
  @@map("events")
}

/// Market templates per sport
model MarketTemplate {
  id        Int      @id @default(autoincrement())
  sportId   Int      @map("sport_id")
  name      String   @db.VarChar(255)
  type      String   @default("bookmaker") @db.VarChar(50)
  isDefault Boolean  @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")

  sport Sport @relation(fields: [sportId], references: [id])

  @@map("market_templates")
}

/// Betting markets for events
model Market {
  id           Int      @id @default(autoincrement())
  eventId      Int      @map("event_id")
  title        String   @db.VarChar(255)
  type         String   @default("bookmaker") @db.VarChar(50)
  backOdds     Float    @default(1.0) @map("back_odds")
  layOdds      Float    @default(1.0) @map("lay_odds")
  minStake     Float    @default(100) @map("min_stake")
  maxStake     Float    @default(1000000) @map("max_stake")
  status       String   @default("open") @db.VarChar(20)
  displayOrder Int      @default(0) @map("display_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id])
  bets  Bet[]

  @@index([eventId])
  @@index([status])
  @@map("markets")
}

/// User bets
model Bet {
  id             Int      @id @default(autoincrement())
  userId         String   @map("user_id") @db.Uuid
  marketId       Int      @map("market_id")
  eventId        Int      @map("event_id")
  betType        String   @map("bet_type") @db.VarChar(10)
  odds           Float
  stake          Float
  potentialProfit Float  @map("potential_profit")
  status         String   @default("pending") @db.VarChar(20)
  matchedAt      DateTime? @map("matched_at")
  settledAt      DateTime? @map("settled_at")

  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  @@index([userId])
  @@index([marketId])
  @@index([eventId])
  @@index([status])
  @@index([createdAt])
  @@map("bets")
}

// ═══════════════════════════════════════════════════════════════
// 4. AUDIT & LOGS
// ═══════════════════════════════════════════════════════════════

/// Track every action in the system
model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(50)
  entityId  String?  @map("entity_id")
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  ip        String?  @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

/// System-level logs
model SystemLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     String   @db.VarChar(20)
  message   String   @db.Text
  context   Json?
  stack     String?  @db.Text
  ip        String?  @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([level])
  @@index([createdAt])
  @@map("system_logs")
}

/// User notifications
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String    @db.VarChar(255)
  message   String    @db.Text
  type      String    @default("info") @db.VarChar(20)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  link      String?   @db.VarChar(255)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ═══════════════════════════════════════════════════════════════
// 5. CONFIGURATION
// ═══════════════════════════════════════════════════════════════

/// System settings (key-value store)
model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       Json
  type        String   @default("string") @db.VarChar(20)
  group       String   @default("general") @db.VarChar(50)
  description String?  @db.Text
  isPublic    Boolean  @default(false) @map("is_public")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([group])
  @@map("settings")
}

/// Supported countries
model Country {
  id        String  @id @default(uuid()) @db.Uuid
  name      String  @db.VarChar(100)
  code      String  @unique @db.VarChar(2)
  dialCode  String? @map("dial_code") @db.VarChar(10)
  flag      String? @db.VarChar(10)
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([code])
  @@map("countries")
}

/// Supported currencies
model Currency {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @db.VarChar(100)
  code     String  @unique @db.VarChar(3)
  symbol   String? @db.VarChar(5)
  rate     Float   @default(1.0)
  isBase   Boolean @default(false) @map("is_base")
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([code])
  @@map("currencies")
}

/// User bank accounts for withdrawals
model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  bankName      String   @map("bank_name") @db.VarChar(255)
  accountName   String   @map("account_name") @db.VarChar(255)
  accountNumber String   @map("account_number") @db.VarChar(50)
  ifscCode      String?  @map("ifsc_code") @db.VarChar(20)
  upiId         String?  @map("upi_id") @db.VarChar(100)
  isVerified    Boolean  @default(false) @map("is_verified")
  isDefault     Boolean  @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([userId])
  @@map("bank_accounts")
}

/// API keys for programmatic access
model ApiKey {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  key       String   @unique @db.VarChar(64)
  secret    String   @db.VarChar(128)
  scopes    Json?
  isActive  Boolean  @default(true) @map("is_active")
  lastUsed  DateTime? @map("last_used")
  expiresAt DateTime? @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("api_keys")
}
